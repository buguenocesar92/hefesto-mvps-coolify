#!/usr/bin/env bash
# stub de git para tests: implementa `git -C <dir> archive coolify -- <path>`
# imprimiendo un tar con el contenido de <dir>/coolify/.
repo=""
saw_archive=0
saw_double_dash=0
ref=""
paths=()
while [[ $# -gt 0 ]]; do case "$1" in
  -C) repo="$2"; shift 2 ;;
  archive) saw_archive=1; shift ;;
  --) saw_double_dash=1; shift ;;
  *)
    if [ "$saw_archive" -eq 1 ] && [ "$saw_double_dash" -eq 0 ]; then
      if [ -z "$ref" ]; then ref="$1"; fi
    elif [ "$saw_double_dash" -eq 1 ]; then
      paths+=("$1")
    fi
    shift ;;
esac; done

if [ "$saw_archive" -eq 1 ] && [ "$ref" = "coolify" ] && [ -d "$repo/coolify" ]; then
  tar -cf - -C "$repo" "coolify"
  exit 0
fi
exit 1
